# Copie esse arquivo pra "terraform.tfvars" e preencha com os seus valores.
# O terraform.tfvars de verdade NÃO vai pro git (está no .gitignore),
# porque pode ter informação específica da minha conta.

aws_region    = "us-east-1"
project_name  = "fase1-devops"
instance_type = "t3.micro"
app_port      = 3000

# troque pelo link do SEU repositório depois de criar no GitHub
repo_url = "https://github.com/SEU-USUARIO/fase1-devops-na-pratica.git"

# no AWS Academy (Learner Lab) descomente a linha abaixo:
# instance_profile = "LabInstanceProfile"

# se tiver um par de chaves criado na AWS e quiser acessar por SSH, coloque o nome:
# key_name = "minha-chave"
